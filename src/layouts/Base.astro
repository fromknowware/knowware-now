---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/kw.css';
import { SITE_NAME, SITE_TAGLINE, SITE_URL, AUTHOR, PUBLISHER, OG_IMAGE, ORDER_HREF, ORDER_CTA, PRICE_SAVING, CHECKOUT_OPEN } from '../config';
import { markdownHrefFor } from '../lib/markdown-pages.mjs';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'A field guide for a world where machines think. A study of coordination built from 81 synthesized voices, not interviews — the third body between hardware and software.',
  ogImage = OG_IMAGE,
  ogImageAlt,
  ogType = 'website',
  canonical,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE_NAME}` : `${SITE_NAME} — ${SITE_TAGLINE}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE_URL).toString();

const path = Astro.url.pathname;
const markdownHref = markdownHrefFor(path);
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}

const NAV = [
  { href: '/',           num: '01', label: 'Index'      },
  { href: '/the-81',     num: '02', label: 'The 81'     },
  { href: '/read',       num: '03', label: 'Manuscript' },
  { href: '/contribute', num: '04', label: 'Contribute' },
  { href: '/method',     num: '05', label: 'Method'     },
  { href: '/stories',    num: '06', label: 'Stories'    },
  { href: '/agents',     num: '07', label: 'Agents'     },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex" />}
  {markdownHref && <link rel="alternate" type="text/markdown" href={markdownHref} />}
  <link rel="describedby" type="text/plain" href="/llms.txt" />
  <link rel="alternate" type="application/atom+xml" title={`${SITE_NAME} Stories`} href={`${SITE_URL}/feed.xml`} />

  <!-- Theme color -->
  <meta name="theme-color" content="#EDEEE4" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)" />

  <!-- Icons -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogImageAlt ?? `${SITE_NAME} — ${SITE_TAGLINE}`} />
  <meta name="twitter:image:alt" content={ogImageAlt ?? `${SITE_NAME} — ${SITE_TAGLINE}`} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Book",
        "name": `${SITE_NAME}: ${SITE_TAGLINE}`,
        "author": { "@type": "Person", "name": AUTHOR },
        "publisher": { "@type": "Organization", "name": PUBLISHER },
        "url": SITE_URL,
        "image": ogImage,
        "description": description,
        "datePublished": "2026-12-21",
        "inLanguage": "en",
        // No Offer until a real checkout exists: a price marked available
        // for a book nobody can order would be a false signal to agents.
        ...(CHECKOUT_OPEN ? { "offers": { "@type": "Offer", "price": "33.00", "priceCurrency": "USD", "availability": "https://schema.org/PreOrder", "url": `${SITE_URL}/order` } } : {})
      },
      { "@type": "WebSite", "name": SITE_NAME, "url": SITE_URL }
    ]
  })} />

  <script is:inline>
    try { var t = localStorage.getItem('kw-theme'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
  </script>

</head>
<body>

<a href="#main" class="kw-skip">Skip to content</a>

<!-- Dock bar -->
<div id="kw-dock" role="region" aria-label="Pre-order">
  <span id="kw-dock-countdown"></span>
  <span id="kw-dock-sep" aria-hidden="true" style="margin: 0 10px">·</span>
  <span id="kw-dock-saving" style="color: rgba(237,238,228,0.72)">{PRICE_SAVING}</span>
  <a href={ORDER_HREF} id="kw-dock-cta">{ORDER_CTA}</a>
</div>

<!-- Nav -->
<nav class="kw-nav-shell" aria-label="Site">
  <a href="/" class="kw-nav-logo">
    <span class="kw-dot"></span>
    <span class="kw-nav-logo-text">Knowware</span>
  </a>
  <div class="kw-nav-tabs">
    {NAV.map(({ href, num, label }) => (
      <a href={href} class={`kw-nav-tab${isActive(href) ? ' is-active' : ''}`} aria-current={isActive(href) ? 'page' : undefined}>
        <span class="kw-nav-tab-num">{num}</span>
        <span class="kw-nav-tab-label">{label}</span>
      </a>
    ))}
    <button type="button" class="kw-theme-btn" id="kw-theme-btn" aria-label="Theme: Light. Switch theme" title="Switch theme">
      <svg class="kw-theme-icon kw-theme-icon--light" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="kw-theme-icon kw-theme-icon--dark" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
      <svg class="kw-theme-icon kw-theme-icon--warm" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 18a6 6 0 0 1 12 0"/><path d="M2 18h20M12 7v2M5 11l1.4 1.4M19 11l-1.4 1.4M7 21.5h10"/></svg>
    </button>
  </div>
</nav>

<!-- Page content -->
<main id="main" tabindex="-1">
  <slot />
</main>

<!-- Footer -->
<footer class="kw-foot">
  <div class="kw-foot-main">
    <div class="kw-foot-letter-col">
      <p class="kw-foot-letter">Write us a letter.<br />An email is also a letter.</p>
      <a href="mailto:hello@knowware.press" class="kw-foot-email">hello@knowware.press</a>
    </div>
    <div class="kw-foot-meta-col">
      KNOWWARE / VOL. I<br />
      MMXXVI · ED. 01<br />
      MACHINE-COORDINATED.<br />
      HUMAN-OPERATED.
    </div>
  </div>
  <div class="kw-foot-colophon">
    <span>Knowware / Systems of Intelligence</span>
    <span>MMXXVI · Edition 01</span>
    <span>~350 pp · 09 ch · 81 voices</span>
    <span>knowware.press</span>
  </div>
</footer>

<script src="../scripts/kw.ts"></script>

</body>
</html>
