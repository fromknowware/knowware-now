---
// One email field for one of the two lists (news, or the pre-order list). Each list has its own
// form, endpoint and consent wording; nothing here joins the other list. The consent text is shown
// next to the button, and is the exact wording stored with the sign-up.
interface Props {
  id: string;
  endpoint: string;
  heading: string;
  button: string;
  consent: string;
  sent: string;
}
const { id, endpoint, heading, button, consent, sent } = Astro.props;
---
<form class="lf-form" id={`${id}-form`} method="post" action={endpoint} novalidate data-endpoint={endpoint} data-button={button} data-sent={sent} aria-labelledby={`${id}-h`}>
  <h2 class="lf-h" id={`${id}-h`}>{heading}</h2>
  <div class="lf-field">
    <label for={`${id}-email`}>Email</label>
    <input type="email" id={`${id}-email`} name="email" required maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" aria-describedby={`${id}-err ${id}-fine`} />
    <p class="lf-err" id={`${id}-err`}></p>
  </div>
  <div class="lf-trap" aria-hidden="true">
    <label for={`${id}-company`}>Company</label>
    <input type="text" id={`${id}-company`} name="company" tabindex="-1" autocomplete="off" />
  </div>
  <button type="submit" class="kw-btn kw-btn--filled lf-submit">{button}</button>
  <p class="lf-fine" id={`${id}-fine`}><strong>{consent}</strong> We email you once to confirm; nothing is sent after that until you confirm. <slot /></p>
  <p class="lf-live" role="status" aria-live="polite"></p>
</form>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('.lf-form')) {
    const email = form.querySelector<HTMLInputElement>('input[name=email]')!;
    const trap = form.querySelector<HTMLInputElement>('input[name=company]')!;
    const err = form.querySelector<HTMLElement>('.lf-err')!;
    const live = form.querySelector<HTMLElement>('.lf-live')!;
    const submit = form.querySelector<HTMLButtonElement>('.lf-submit')!;
    const setError = (msg: string) => {
      err.textContent = msg;
      if (msg) email.setAttribute('aria-invalid', 'true'); else email.removeAttribute('aria-invalid');
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      email.value = email.value.trim();
      if (!email.checkValidity()) { setError('Enter a valid email address, like name@example.com.'); live.textContent = ''; email.focus(); return; }
      setError('');
      submit.disabled = true;
      live.textContent = 'Sending…';
      try {
        const res = await fetch(form.dataset.endpoint!, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email.value, company: trap.value }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          live.textContent = form.dataset.sent!;
          live.tabIndex = -1;
          live.focus();
          return;
        }
        if (Array.isArray(data.fields) && data.fields.includes('email')) { setError(data.error ?? 'Enter a valid email address.'); live.textContent = ''; email.focus(); }
        else live.textContent = data.error ?? (res.status === 429 ? 'Too many sign-ups from this connection. Try again in an hour.' : 'Something went wrong. Try again in a moment.');
      } catch {
        live.textContent = 'Could not reach the server. Try again in a moment.';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .lf-form { display: grid; gap: 16px; max-width: 460px; }
  .lf-h { font: 700 clamp(24px, 3.4vw, 36px)/1.1 "Helvetica Neue", Helvetica, Arial, sans-serif; letter-spacing: -.03em; margin: 8px 0 4px; color: var(--ink); }
  .lf-field label { display: block; font: 500 13px/1.3 "JetBrains Mono", ui-monospace, monospace; margin-bottom: 6px; color: var(--ink); }
  .lf-field input {
    width: 100%; box-sizing: border-box; padding: 12px; font: 400 16px/1.3 "JetBrains Mono", ui-monospace, monospace;
    color: var(--ink); background: transparent; border: 1px solid var(--rule-strong); border-radius: 0;
  }
  .lf-field input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .lf-field input[aria-invalid="true"] { border-width: 2px; border-color: var(--error); }
  .lf-err { margin: 6px 0 0; font-size: 13px; color: var(--error); }
  .lf-err:empty { display: none; }
  .lf-fine { margin: 0; font-size: 14px; line-height: 1.5; color: var(--sub); }
  .lf-fine a { color: var(--signal-ink); text-decoration: underline; text-underline-offset: 3px; }
  .lf-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .lf-live { margin: 0; font-size: 17px; line-height: 1.45; color: var(--ink); min-height: 1.4em; }
  .lf-live:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
</style>
