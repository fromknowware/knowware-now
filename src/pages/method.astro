---
import Base from '../layouts/Base.astro';

const LINEAGE = [
  { year: '1948', name: 'Norbert Wiener',  label: 'Cybernetics',        note: 'Control and communication in the animal and the machine. Feedback loops between human operators and anti-aircraft radar — the first formal model of human-machine coordination.' },
  { year: '1956', name: 'W. Ross Ashby',   label: 'Requisite Variety',  note: "Law of Requisite Variety: only variety can absorb variety. A system's regulatory capacity must match the complexity of its environment — the formal condition for coordination to hold." },
  { year: '1972', name: 'Stafford Beer',   label: 'Viable System Model',note: 'Five nested subsystems required for any living organisation to survive. System 3 coordinates operations. System 4 scans the environment. System 5 holds identity. Without all five, the organisation dies.' },
  { year: '1972', name: 'Gregory Bateson', label: 'Ecology of Mind',    note: 'Levels of Learning: Learning I is stimulus-response; Learning II is recognising patterns across contexts; Learning III is a paradigm shift in how reality is framed. Knowware requires Learning II.' },
  { year: '1975', name: 'Gordon Pask',     label: 'Conversation Theory',note: 'Knowledge does not reside in either participant of a conversation — it emerges from the interaction between them. Paskian conversations at scale are exactly what the 81 syntheses represent.' },
];

const RECOGNIZERS = [
  { domain: 'Kitchen',      figure: 'The Chef',      text: 'Thirty years on the line. When the sauté cook adjusts to the sound of the sear two stations over — no words, just weight and timing — that silent choreography is the same pattern. The brigade system is coordination intelligence with fire.' },
  { domain: 'Construction', figure: 'The Foreman',   text: 'AI-coordinated logistics on a major job site. The software didn\'t swing the hammers — it orchestrated delivery windows, pour schedules, and crew movement. The site finished three weeks early. Zero safety incidents. Neither the human nor the machine did that alone.' },
  { domain: 'Classroom',    figure: 'The Teacher',   text: 'Watching a student use an AI writing tool to produce an essay. The student guided. The AI suggested. The student edited. The resulting work was something neither could have written independently. The intelligence lived in the exchange.' },
  { domain: 'Autocomplete', figure: 'The Sentence',  text: 'You type "looking forward to" and Gmail offers "seeing you tomorrow" in grey. You read it. You agree. Tab. Who wrote that sentence? You had the intent. The machine had the probability. You coordinated. That sentence is the Third Body in three seconds.' },
];

const FORMULA = [
  ['C',       'Coordination — the active process, not a static state'],
  ['A',       'Human expertise: domain knowledge, lived experience, authorial intent'],
  ['B',       'Machine synthesis: pattern recognition at scale, cross-domain connection'],
  ['Context', 'The specific problem space, the question asked, the coordination architecture'],
  ['Emergence','The Third Body — insights that belong to neither A nor B alone'],
];

const TWO_BODY = [
  ['Mechanism',  'Machine generates content directly from training data. No grounding in specific human expertise.'],
  ['Constraint', 'Lacks contextual coordination and intentional design. The output may appear authoritative but simulates authority rather than earning it.'],
  ['Result',     'A stochastic parrot. Confident confabulation. No Third Body — only the machine pretending to be one.'],
];

const THREE_BODY = [
  ['Body A',    'Human expertise: decades of published work by named thinkers — verified, cited, real.'],
  ['Body B',    'Machine pattern recognition: finding cross-domain connections no single human mind could hold simultaneously.'],
  ['Context',   'Authorial intent: the author\'s coordination architecture — the questions asked, the curation applied, the critical editing that shaped every synthesis.'],
  ['Result',    'Paskian conversations at scale. The synthesis IS the Third Body. Knowledge that emerges from the interaction, not from either participant alone.'],
];
---
<Base
  title="Method"
  description="The synthesis is the proof. C(A, B, Context) → Emergence — how 81 human corpora were coordinated through machine synthesis to produce what neither could generate alone."
>

  <!-- Masthead strip -->
  <div class="method-mast mono">
    <span>METHOD / 04</span>
    <span>COORDINATION SYNTHESIS</span>
    <span>EPISTEMIC ARCHITECTURE</span>
    <span style="text-align:right">SYSTEMS OF INTELLIGENCE</span>
  </div>

  <!-- Hero: full-bleed ink -->
  <div class="method-hero">
    <div class="method-hero-inner">
      <div class="method-hero-lbl mono">THE SYNTHESIS IS THE PROOF</div>
      <blockquote class="method-hero-quote">
        "No human interviewer sat across from Stuart Russell, Melanie Mitchell,
        or Judea Pearl. Instead, their published thinking — decades of papers,
        lectures, debates, and books — was coordinated through an AI system that
        found emergent patterns none of them articulated alone."
      </blockquote>
      <p class="method-hero-sub">
        What you are reading is not interviews. It is the Third Body in action —
        human knowledge coordinated with machine synthesis to produce insights
        that neither could generate independently.{' '}
        <strong class="method-hero-accent">
          This book is not about Knowware. This book IS Knowware.
        </strong>
      </p>
    </div>
  </div>

  <!-- 01 · Two bodies vs three bodies -->
  <div class="method-section">
    <div class="method-section-lbl mono">01 · TWO BODIES VS THREE BODIES</div>
    <div class="method-compare-grid">
      <div class="method-compare-col">
        <div class="method-compare-tag mono">TWO-BODY SYSTEM</div>
        <h2 class="method-compare-h2">AI Hallucination</h2>
        {TWO_BODY.map(([k, v]) => (
          <div class="method-kv">
            <span class="method-kv-key mono">{k}</span>
            <span class="method-kv-val">{v}</span>
          </div>
        ))}
      </div>
      <div class="method-compare-col method-compare-col--right">
        <div class="method-compare-tag mono" style="color:var(--signal)">THREE-BODY SYSTEM</div>
        <h2 class="method-compare-h2">Coordination Synthesis</h2>
        {THREE_BODY.map(([k, v]) => (
          <div class="method-kv">
            <span class="method-kv-key mono" style="color:var(--signal)">{k}</span>
            <span class="method-kv-val">{v}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- 02 · Recognition examples -->
  <div class="method-section">
    <div class="method-section-lbl mono">02 · RECOGNITION OVER REVELATION</div>
    <p class="method-intro-p">
      You do not need to accept a new theory. You need to recognise what you already know.
      The pattern existed before the name.
    </p>
    <div class="method-recognizers">
      {RECOGNIZERS.map((r) => (
        <div class="method-recognizer">
          <div class="method-rec-hd">
            <span class="method-rec-figure">{r.figure}</span>
            <span class="mono method-rec-domain">{r.domain.toUpperCase()}</span>
          </div>
          <p class="method-rec-text">{r.text}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- 03 · The formula -->
  <div class="method-section method-formula-section">
    <div class="method-section-lbl mono">03 · THE COORDINATION FUNCTION</div>
    <div class="method-formula-grid">
      <div>
        <div class="method-formula-display">
          C(A, B, Context) → Emergence
        </div>
        <div class="method-formula-defs">
          {FORMULA.map(([sym, def]) => (
            <div class="method-formula-row">
              <span class="method-formula-sym">{sym}</span>
              <span class="method-formula-def">{def}</span>
            </div>
          ))}
        </div>
      </div>
      <div class="method-formula-prose">
        <p>
          The formula formalises what Gordon Pask proved in 1975: knowledge
          is not extracted from one mind and deposited into another. It
          <em>emerges from the interaction</em> between participants.
        </p>
        <p style="color:var(--sub)">
          In the 81 syntheses, Body A is the thinker's published corpus —
          verified, citable, real. Body B is the pattern-recognition layer
          that spans decades and domains simultaneously. The Context is the
          author's coordination architecture: the specific questions,
          the editorial curation, the insistence on divergence over
          mere summary.
        </p>
        <p style="color:var(--sub)">
          What emerges is not a simulation of an interview. It is something
          an interview could not produce — pattern synthesis across an
          entire intellectual life, held simultaneously.
        </p>
      </div>
    </div>
  </div>

  <!-- 04 · Lineage -->
  <div class="method-section method-lineage-section">
    <div class="method-section-lbl mono">04 · THE LINEAGE</div>
    <p class="method-intro-p">
      This concept is not new. That is not a weakness — it is sixty years
      of validation. Knowware is where these frameworks converge.
    </p>
    <div class="method-lineage">
      {LINEAGE.map((l, i) => (
        <div class={`method-lineage-row${i < LINEAGE.length - 1 ? '' : ' method-lineage-row--last'}`}>
          <div class="method-lineage-year">
            <span class="mono">{l.year}</span>
          </div>
          <div class="method-lineage-content">
            <div class="method-lineage-name-row">
              <span class="method-lineage-name">{l.name}</span>
              <span class="mono method-lineage-label">{l.label.toUpperCase()}</span>
            </div>
            <p class="method-lineage-note">{l.note}</p>
          </div>
        </div>
      ))}
    </div>
    <div class="method-lineage-foot mono">
      <span>Wiener → Ashby → Beer → Bateson → Pask → Knowware</span>
      <span style="color:var(--sub2)">1948 — 2026</span>
    </div>
  </div>

</Base>

<style>
/* Masthead */
.method-mast {
  border-bottom: 1px solid var(--rule);
  padding: 10px 24px;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px; font-size: 10px; color: var(--sub);
}

/* Hero */
.method-hero {
  background: var(--ink); color: var(--paper);
  padding: 64px 48px 72px;
  border-bottom: 1px solid var(--rule);
}
.method-hero-inner { max-width: 820px; }
.method-hero-lbl {
  font-size: 10px; color: oklch(0.60 0.04 250);
  letter-spacing: 0.06em; margin-bottom: 28px;
}
.method-hero-quote {
  margin: 0; font-size: clamp(18px,2.5vw,28px);
  line-height: 1.35; letter-spacing: -0.015em;
  font-style: italic; color: var(--paper);
  border: none; padding: 0;
}
.method-hero-sub {
  margin: 28px 0 0; font-size: clamp(15px,1.8vw,18px);
  line-height: 1.45; letter-spacing: -0.012em;
  color: oklch(0.72 0.04 250);
}
.method-hero-accent { color: oklch(0.78 0.04 250); font-weight: 500; }

/* Sections */
.method-section {
  padding: 56px 48px;
  border-bottom: 1px solid var(--rule);
}
.method-section-lbl {
  font-size: 10px; color: var(--sub);
  letter-spacing: 0.06em; margin-bottom: 24px;
}
.method-intro-p {
  font-size: clamp(15px,1.8vw,18px); line-height: 1.45;
  letter-spacing: -0.012em; margin: 0 0 36px;
  max-width: 680px; color: var(--sub);
}

/* Compare grid */
.method-compare-grid {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 2px; border: 1px solid var(--ink);
}
.method-compare-col {
  padding: 32px; border-right: 1px solid var(--ink);
}
.method-compare-col--right { border-right: none; background: var(--paper); }
.method-compare-tag {
  font-size: 9px; letter-spacing: 0.06em; color: var(--sub); margin-bottom: 16px;
}
.method-compare-h2 {
  font: 500 clamp(18px,2vw,22px)/1.1 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -0.02em; margin: 0 0 20px;
}
.method-kv {
  display: grid; grid-template-columns: 90px 1fr;
  gap: 12px; margin-bottom: 14px; align-items: start;
}
.method-kv-key { font-size: 10px; color: var(--sub); padding-top: 2px; }
.method-kv-val { font-size: 13px; line-height: 1.55; color: var(--ink); }

/* Recognizers */
.method-recognizers {
  display: grid; grid-template-columns: repeat(2, 1fr);
  gap: 2px; border: 1px solid var(--rule);
}
.method-recognizer {
  padding: 28px 24px;
  border-right: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
}
.method-recognizer:nth-child(2n) { border-right: none; }
.method-recognizer:nth-last-child(-n+2) { border-bottom: none; }
.method-rec-hd {
  display: flex; justify-content: space-between; align-items: baseline;
  margin-bottom: 12px;
}
.method-rec-figure { font-size: 16px; font-weight: 500; letter-spacing: -0.015em; }
.method-rec-domain { font-size: 9px; color: var(--sub); letter-spacing: 0.04em; }
.method-rec-text { margin: 0; font-size: 13px; line-height: 1.65; color: var(--sub); }

/* Formula */
.method-formula-section { background: var(--paper); }
.method-formula-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
.method-formula-display {
  font: 400 clamp(28px,4vw,48px)/1.1 Georgia, serif;
  letter-spacing: -0.03em;
  border-bottom: 2px solid var(--ink);
  padding-bottom: 20px; margin-bottom: 20px;
}
.method-formula-defs { display: flex; flex-direction: column; gap: 12px; }
.method-formula-row {
  display: grid; grid-template-columns: minmax(110px,max-content) 1fr;
  gap: 16px; align-items: baseline;
}
.method-formula-sym {
  font: 500 18px/1.2 Georgia, serif;
  letter-spacing: -0.02em; color: var(--signal);
  white-space: nowrap;
}
.method-formula-def { font-size: 12px; line-height: 1.6; color: var(--sub); }
.method-formula-prose p { font-size: clamp(14px,1.5vw,17px); line-height: 1.5; letter-spacing: -0.012em; margin: 0 0 16px; }

/* Lineage */
.method-lineage-section { padding-bottom: 72px; }
.method-lineage { position: relative; }
.method-lineage::before {
  content: ''; position: absolute; left: 72px; top: 0; bottom: 0;
  width: 1px; background: var(--rule);
}
.method-lineage-row {
  display: grid; grid-template-columns: 72px 1fr;
  border-bottom: 1px solid var(--rule);
  padding: 24px 0;
}
.method-lineage-row--last { border-bottom: none; }
.method-lineage-year { padding-right: 24px; }
.method-lineage-year .mono { font-size: 12px; font-weight: 600; }
.method-lineage-content { padding-left: 32px; }
.method-lineage-name-row { display: flex; gap: 12px; align-items: baseline; margin-bottom: 8px; }
.method-lineage-name { font-size: 17px; font-weight: 500; letter-spacing: -0.015em; }
.method-lineage-label { font-size: 9px; color: var(--signal); letter-spacing: 0.04em; }
.method-lineage-note { margin: 0; font-size: 13px; line-height: 1.65; color: var(--sub); max-width: 640px; }
.method-lineage-foot {
  margin-top: 28px; font-size: 11px; color: var(--sub);
  border-top: 1px solid var(--rule); padding-top: 16px;
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
}

/* Mobile */
@media (max-width: 900px) {
  .method-mast { grid-template-columns: 1fr 1fr; }
  .method-mast > span:nth-child(2),
  .method-mast > span:nth-child(3) { display: none; }
  .method-hero { padding: 40px 16px 48px; }
  .method-section { padding: 40px 16px; }
  .method-compare-grid { grid-template-columns: 1fr; }
  .method-compare-col { border-right: none; border-bottom: 1px solid var(--ink); }
  .method-compare-col--right { border-bottom: none; }
  .method-recognizers { grid-template-columns: 1fr; }
  .method-recognizer { border-right: none !important; }
  .method-recognizer:nth-last-child(-n+2) { border-bottom: 1px solid var(--rule); }
  .method-recognizer:last-child { border-bottom: none; }
  .method-formula-grid { grid-template-columns: 1fr; gap: 32px; }
  .method-lineage::before { display: none; }
  .method-lineage-row { grid-template-columns: 1fr; }
  .method-lineage-content { padding-left: 0; }
  .method-lineage-year { padding: 0 0 8px; }
  .method-lineage-year .mono { font-size: 11px; }
}
</style>
