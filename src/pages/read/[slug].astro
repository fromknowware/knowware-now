---
import Base from '../../layouts/Base.astro';
import SceneHead from '../../components/SceneHead.astro';
import Field from '../../components/Field.astro';
import { getCollection, render } from 'astro:content';
import { SITE_URL } from '../../config';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((ch) => ({ params: { slug: ch.slug }, props: { chapter: ch } }));
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);

// Load voices for this chapter
const voices = await getCollection('voices');
const chapterVoices = voices
  .filter((v) => v.data.chapter === chapter.data.n)
  .sort((a, b) => Number(a.data.id) - Number(b.data.id));

const tierLabel: Record<string, string> = { A: 'Academic', P: 'Practitioner', V: 'Visionary' };

// Prev / next
const all = await getCollection('chapters');
const sorted = all.sort((a, b) => a.data.n - b.data.n);
const idx = sorted.findIndex((c) => c.slug === chapter.slug);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
---
<Base
  title={chapter.data.opener}
  description={`Chapter ${String(chapter.data.n).padStart(2,'0')} of Knowware: ${chapter.data.opener}`}
  ogType="article"
  canonical={`${SITE_URL}/read/${chapter.slug}`}
>
  <SceneHead n={chapter.data.n} opener={chapter.data.opener} />

  <!-- Field divider -->
  <Field height="180px" sigTop="50%" />

  <!-- Scene prose -->
  <article class="kw-section kw-scene-prose" data-kw-read>
    <Content />
  </article>

  <!-- Diagram — full-bleed dark coordination section -->
  {chapter.data.diagram && (() => {
    const diag = chapter.data.diagram!;
    const visible = diag.nodes.filter(n => !n.latent);
    const latent  = diag.nodes.filter(n => n.latent);
    // SVG geometry — matches original: W=620, H=300
    const W = 620, H = 300;
    const colX = [70, W / 2, W - 70];
    const rowY = [60, H / 2, H - 60];
    const px = (n: typeof diag.nodes[0]) => colX[n.pos[0]];
    const py = (n: typeof diag.nodes[0]) => rowY[n.pos[1]];
    return (
      <section class="ch-diag-section">
        <div class="ch-diag-header mono">
          <span>WHAT THIS CHAPTER COORDINATES</span>
          <span class="ch-diag-fig">FIG · CAUSAL DIAGRAM</span>
        </div>

        <!-- Node boxes row -->
        <div class="ch-diag-node-row">
          {visible.map((node, i) => (
            <>
              <div class="ch-diag-node">
                <span class="ch-diag-node-id mono">{node.id}</span>
                <span class="ch-diag-node-lbl">{node.label.replace('\n', ' ')}</span>
              </div>
              {i < visible.length - 1 && (
                <span class="ch-diag-arrow">→</span>
              )}
            </>
          ))}
        </div>

        <!-- Latent node -->
        {latent.length > 0 && (
          <div class="ch-diag-latent">
            <span class="mono ch-diag-latent-label">LATENT /</span>
            {latent.map(n => (
              <span class="ch-diag-latent-node">{n.label.replace('\n', ' ')}</span>
            ))}
            <span class="ch-diag-latent-note">— the missing third body</span>
          </div>
        )}

        <p class="ch-diag-caption">{diag.caption}</p>

        <!-- SVG causal graph — full width, curved bezier arcs -->
        <div class="ch-diag-svg-wrap">
          <p class="mono ch-diag-svg-label">CAUSAL GRAPH · {diag.title.toUpperCase()}</p>
          <svg viewBox={`0 0 ${W} ${H}`} width="100%" aria-hidden="true" style="display:block;overflow:visible">
            {diag.arcs.map((arc, i) => {
              const fn = diag.nodes.find(n => n.id === arc.from);
              const tn = diag.nodes.find(n => n.id === arc.to);
              if (!fn || !tn) return null;
              const ax = px(fn), ay = py(fn), bx = px(tn), by = py(tn);
              const dx = bx - ax, dy = by - ay;
              const len = Math.max(Math.sqrt(dx*dx + dy*dy), 1);
              const c = 0.14 + (i % 3) * 0.04;
              const nx2 = -dy/len, ny2 = dx/len;
              const mx = (ax+bx)/2 + nx2*len*c;
              const my = (ay+by)/2 + ny2*len*c;
              const R2 = 36;
              const t1 = R2/len, t2 = 1 - R2/len;
              const d = `M ${ax+dx*t1} ${ay+dy*t1} Q ${mx} ${my} ${ax+dx*t2} ${ay+dy*t2}`;
              const isLatent = arc.kind === 'latent';
              return (
                <g>
                  <path
                    d={d}
                    fill="none"
                    stroke={isLatent ? 'oklch(0.55 0.1 250)' : 'oklch(0.75 0.05 250)'}
                    stroke-width={isLatent ? '1' : '1.5'}
                    stroke-dasharray={isLatent ? '4 3' : undefined}
                    marker-end={isLatent ? undefined : 'url(#arr)'}
                  />
                  {arc.label && !isLatent && (
                    <text
                      x={mx} y={my - 7}
                      font-family="JetBrains Mono, monospace"
                      font-size="8"
                      fill="oklch(0.55 0.08 250)"
                      text-anchor="middle"
                    >{arc.label}</text>
                  )}
                </g>
              );
            })}
            <!-- Defs for arrowhead -->
            <defs>
              <marker id="arr" markerWidth="6" markerHeight="6" refX="3" refY="3" orient="auto">
                <path d="M0,0 L6,3 L0,6 Z" fill="oklch(0.75 0.05 250)" />
              </marker>
            </defs>
            <!-- Nodes -->
            {diag.nodes.map(node => {
              const x = px(node), y = py(node);
              const isLatent = node.latent;
              const lines = node.label.split('\n');
              return (
                <g>
                  <circle
                    cx={x} cy={y} r={isLatent ? '22' : '30'}
                    fill={isLatent ? 'oklch(0.14 0.04 250)' : 'oklch(0.18 0.05 250)'}
                    stroke={isLatent ? 'oklch(0.42 0.07 250)' : 'oklch(0.68 0.07 250)'}
                    stroke-width={isLatent ? '1' : '1.5'}
                    stroke-dasharray={isLatent ? '4 3' : undefined}
                  />
                  {lines.map((line, li) => (
                    <text
                      x={x}
                      y={y + (li - (lines.length - 1) / 2) * 12}
                      font-family="JetBrains Mono, monospace"
                      font-size="8.5"
                      fill={isLatent ? 'oklch(0.62 0.09 250)' : 'oklch(0.90 0.03 250)'}
                      text-anchor="middle"
                      dominant-baseline="middle"
                    >{line}</text>
                  ))}
                </g>
              );
            })}
          </svg>
        </div>
      </section>
    );
  })()}

  <!-- Chapter voices -->
  <section class="kw-section">
    <p class="kw-label">Nine Voices — Chapter {String(chapter.data.n).padStart(2,'0')}</p>
    <p class="kw-h3">{chapter.data.title}</p>
    <div class="voice-list">
      {chapterVoices.map((v) => (
        <a class="kw-voice-card" href={`/voices/${v.data.id}`}>
          <span class="kw-voice-num">{v.data.id}</span>
          <div>
            <p class="kw-voice-name">{v.data.name}</p>
            <p class="kw-voice-role">{v.data.role}</p>
            {v.data.coldOpen && (
              <blockquote class="voice-cold-open">
                "{v.data.coldOpen}"
              </blockquote>
            )}
          </div>
          <span class={`kw-tier kw-tier--${v.data.tier}`}>{tierLabel[v.data.tier]}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Prev / next -->
  <nav class="kw-section chapter-nav" aria-label="Chapter navigation">
    {prev ? (
      <a href={`/read/${prev.slug}`} class="chapter-nav-link">
        <span class="mono" style="font-size:11px;color:var(--sub)">← Ch. {String(prev.data.n).padStart(2,'0')}</span>
        <span>{prev.data.opener}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={`/read/${next.slug}`} class="chapter-nav-link" style="text-align:right">
        <span class="mono" style="font-size:11px;color:var(--sub)">Ch. {String(next.data.n).padStart(2,'0')} →</span>
        <span>{next.data.opener}</span>
      </a>
    ) : <span />}
  </nav>
</Base>

<style>
.kw-scene-prose p {
  max-width: 640px;
  font-size: calc(17px * var(--read-scale));
  line-height: var(--read-lh);
  letter-spacing: var(--read-track);
  margin: 0 0 1.4em;
}
.voice-cold-open {
  font: 400 13px/1.6 "JetBrains Mono", ui-monospace, monospace;
  color: var(--sub); margin: 10px 0 0;
  border-left: 2px solid var(--signal); padding-left: 12px;
}
.chapter-nav {
  display: flex; justify-content: space-between; gap: 24px;
}
.chapter-nav-link {
  display: flex; flex-direction: column; gap: 4px;
  font: 600 14px/1.2 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -.01em; color: var(--ink); max-width: 300px;
}
.chapter-nav-link:hover { color: var(--accent); }

/* ── Causal diagram section ────────────────────────────── */
.ch-diag-section {
  background: var(--ink);
  color: var(--paper);
  padding: clamp(32px,5vw,56px) clamp(20px,5vw,64px) clamp(40px,6vw,64px);
}
.ch-diag-header {
  font-size: 10px; letter-spacing: 0.06em;
  color: oklch(0.65 0.1 250);
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  margin-bottom: 24px;
}
.ch-diag-fig { color: oklch(0.45 0.06 250); }

.ch-diag-node-row {
  display: flex; align-items: stretch; gap: 0;
  overflow-x: auto; padding-bottom: 4px;
  margin-bottom: 16px;
}
.ch-diag-node {
  border: 1px solid oklch(0.32 0.05 250);
  padding: 14px 20px; flex-shrink: 0;
  background: oklch(0.14 0.04 250); min-width: 100px;
  display: flex; flex-direction: column; gap: 6px;
}
.ch-diag-node-id {
  font-size: 9px; color: oklch(0.55 0.1 250); letter-spacing: 0.05em;
}
.ch-diag-node-lbl {
  font: 500 14px/1.3 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -0.01em; color: var(--paper);
  white-space: nowrap;
}
.ch-diag-arrow {
  display: flex; align-items: center;
  padding: 0 10px; color: oklch(0.55 0.1 250);
  font-size: 16px; flex-shrink: 0;
}

.ch-diag-latent {
  padding-top: 14px; margin-top: 0;
  border-top: 1px solid oklch(0.25 0.04 250);
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  margin-bottom: 16px;
}
.ch-diag-latent-label {
  font-size: 9px; color: oklch(0.55 0.1 250); letter-spacing: 0.05em;
}
.ch-diag-latent-node {
  border: 1px dashed oklch(0.40 0.05 250);
  padding: 8px 14px;
  font: 400 13px/1.3 "Helvetica Neue", Helvetica, Arial, sans-serif;
  color: oklch(0.78 0.04 250); letter-spacing: -0.01em;
}
.ch-diag-latent-note {
  font-size: 11px; color: oklch(0.50 0.06 250);
}

.ch-diag-caption {
  font-size: 12px; color: oklch(0.52 0.06 250);
  line-height: 1.6; margin: 0 0 20px;
}

.ch-diag-svg-wrap {
  border-top: 1px solid oklch(0.25 0.04 250);
  padding-top: 18px;
}
.ch-diag-svg-label {
  font-size: 9px; letter-spacing: 0.04em;
  color: oklch(0.50 0.08 250); margin: 0 0 10px;
}
</style>
