---
import { chapterNum } from '../../lib/chapters';
import Base from '../../layouts/Base.astro';
import SceneHead from '../../components/SceneHead.astro';
import Field from '../../components/Field.astro';
import CausalDiagram from '../../components/CausalDiagram.astro';
import ReaderGate from '../../components/ReaderGate.astro';
import SynthesisNote from '../../components/SynthesisNote.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { SITE_URL } from '../../config';

export async function getStaticPaths() {
  const chapters = await getCollection('chapters');
  return chapters.map((ch) => ({ params: { slug: ch.id }, props: { chapter: ch } }));
}

const { chapter } = Astro.props;
const preview = await getEntry('manuscript', `${chapter.id}-preview`);
if (!preview) throw new Error(`Missing manuscript preview for chapter ${chapter.id}`);
const { Content: Preview } = await render(preview);

// Load voices for this chapter
const voices = await getCollection('voices');
const chapterVoices = voices
  .filter((v) => v.data.chapter === chapter.data.n)
  .sort((a, b) => Number(a.data.id) - Number(b.data.id));

const tierLabel: Record<string, string> = { A: 'Academic', P: 'Practitioner', V: 'Visionary' };

// Prev / next
const all = await getCollection('chapters');
const sorted = all.sort((a, b) => a.data.n - b.data.n);
const idx = sorted.findIndex((c) => c.id === chapter.id);
const prev = idx > 0 ? sorted[idx - 1] : null;
const next = idx < sorted.length - 1 ? sorted[idx + 1] : null;
---
<Base
  title={chapter.data.opener}
  description={`Chapter ${chapterNum(chapter.data.n)} of Knowware: ${chapter.data.opener}`}
  ogType="article"
  canonical={`${SITE_URL}/read/${chapter.id}`}
>
  <SceneHead n={chapter.data.n} opener={chapter.data.opener} />

  <!-- Field divider -->
  <Field height="180px" sigTop="50%" />

  <!-- Chapter opening (free preview) -->
  <article class="kw-section kw-prose kw-preview" data-kw-read aria-labelledby="preview-h">
    <h2 class="sr-only" id="preview-h">Chapter opening</h2>
    {preview.data.dek && <p class="kw-prose-dek">{preview.data.dek}</p>}
    <div class="kw-preview-body">
      <Preview />
    </div>
  </article>

  <ReaderGate
    slug={chapter.id}
    n={chapter.data.n}
    previewWords={preview.data.words}
    totalWords={preview.data.totalWords}
    readMinutes={preview.data.readMinutes}
  />

  <Field height="96px" sigTop="50%" />

  <!-- Diagram — full-bleed dark coordination section -->
  {chapter.data.diagram && <CausalDiagram diagram={chapter.data.diagram} />}

  <!-- Chapter voices (the capstone has none of its own) -->
  {chapterVoices.length > 0 && (
  <section class="kw-section">
    <p class="kw-label">Nine Voices · Chapter {chapterNum(chapter.data.n)}</p>
    <h2 class="kw-h3">{chapter.data.title}</h2>
    <div class="voice-list">
      {chapterVoices.map((v) => (
        <a class="kw-voice-card" href={`/voices/${v.data.id}`}>
          <span class="kw-voice-num">{v.data.id}</span>
          <div>
            <p class="kw-voice-name">{v.data.name}</p>
            <p class="kw-voice-role">{v.data.role}</p>
            {v.data.coldOpen && (
              <div class="voice-cold-open">
                <p class="voice-cold-open-text">{v.data.coldOpen}<sup class="kw-ast" aria-hidden="true">*</sup></p>
                <SynthesisNote name={v.data.name} anon={v.data.status === 'anon'} link={false} />
              </div>
            )}
          </div>
          <span class={`kw-tier kw-tier--${v.data.tier}`}>{tierLabel[v.data.tier]}</span>
        </a>
      ))}
    </div>
  </section>
  )}

  <!-- Prev / next -->
  <nav class="kw-section chapter-nav" aria-label="Chapter navigation">
    {prev ? (
      <a href={`/read/${prev.id}`} class="chapter-nav-link">
        <span class="mono" style="font-size:11px;color:var(--sub)">← Ch. {chapterNum(prev.data.n)}</span>
        <span>{prev.data.opener}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={`/read/${next.id}`} class="chapter-nav-link" style="text-align:right">
        <span class="mono" style="font-size:12px;color:var(--sub)">Ch. {chapterNum(next.data.n)} →</span>
        <span>{next.data.opener}</span>
      </a>
    ) : <span />}
  </nav>
</Base>

<style>
.voice-cold-open {
  font: 400 13px/1.6 "JetBrains Mono", ui-monospace, monospace;
  color: var(--sub); margin: 10px 0 0;
  background: var(--accent-soft); padding: 10px 14px;
  border: 1px dashed var(--sub);
}
.voice-cold-open-text { margin: 0; }
.kw-ast { font-size: .85em; font-weight: 600; vertical-align: super; line-height: 0; margin-left: 2px; color: var(--ink); }
.chapter-nav {
  display: flex; justify-content: space-between; gap: 24px;
}
.chapter-nav-link {
  display: flex; flex-direction: column; gap: 4px;
  font: 600 14px/1.2 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -.01em; color: var(--ink); max-width: 300px;
}
.chapter-nav-link:hover { color: var(--signal-ink); }

/* ── Causal diagram section ────────────────────────────── */
.ch-diag-section {
  background: var(--band-bg);
  color: var(--band-ink);
  padding: clamp(32px,5vw,56px) clamp(20px,5vw,64px) clamp(40px,6vw,64px);
}
.ch-diag-header {
  font-size: 11px; letter-spacing: 0.06em;
  color: var(--band-sub);
  display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  margin-bottom: 24px;
}
.ch-diag-fig { color: var(--band-mute); }

.ch-diag-node-row {
  display: flex; align-items: stretch; flex-wrap: wrap; gap: 8px 0;
  padding-bottom: 4px;
  margin-bottom: 16px;
}
.ch-diag-node {
  border: 1px solid var(--band-node-line);
  padding: 14px 20px; flex-shrink: 0;
  background: var(--band-node-bg); min-width: 100px;
  display: flex; flex-direction: column; gap: 6px;
}
.ch-diag-node-id {
  font-size: 11px; color: var(--band-mute); letter-spacing: 0.05em;
}
.ch-diag-node-lbl {
  font: 500 14px/1.3 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -0.01em; color: var(--band-ink);
}
.ch-diag-arrow {
  display: flex; align-items: center;
  padding: 0 10px; color: var(--band-mute);
  font-size: 16px; flex-shrink: 0;
}

.ch-diag-latent {
  padding-top: 14px; margin-top: 0;
  border-top: 1px solid var(--band-rule);
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  margin-bottom: 16px;
}
.ch-diag-latent-label {
  font-size: 11px; color: var(--band-mute); letter-spacing: 0.05em;
}
.ch-diag-latent-node {
  border: 1px dashed var(--band-node-line);
  padding: 8px 14px;
  font: 400 13px/1.3 "Helvetica Neue", Helvetica, Arial, sans-serif;
  color: var(--band-sub); letter-spacing: -0.01em;
}
.ch-diag-latent-note {
  font-size: 12px; color: var(--band-mute);
}

.ch-diag-caption {
  font-size: 13px; color: var(--band-sub);
  line-height: 1.6; margin: 0 0 20px;
}

.ch-diag-svg-wrap {
  border-top: 1px solid var(--band-rule);
  padding-top: 18px;
}
.ch-diag-svg-label {
  font-size: 11px; letter-spacing: 0.04em;
  color: var(--band-mute); margin: 0 0 10px;
}

.chapter-nav-link { min-height: 44px; }

@media (max-width: 640px) {
  /* Nine-voices cards: number and tier share the first row, the card body gets the full width
     (the 40px number gutter squeezed the cold-open box to two thirds and pushed the tier badge off screen). */
  .kw-voice-card { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "num tier" "body body"; gap: 8px 12px; padding: 18px 0; }
  .kw-voice-card > .kw-voice-num { grid-area: num; font-size: 12px; align-self: center; }
  .kw-voice-card > .kw-tier { grid-area: tier; font-size: 12px; align-self: center; }
  .kw-voice-card > div { grid-area: body; min-width: 0; }
  .kw-voice-name { font-size: 17px; }
  .voice-cold-open { font-size: 14px; padding: 12px 14px; overflow-wrap: anywhere; }
  .kw-voice-role { font-size: 12px; }

  .chapter-nav { flex-direction: column; gap: 0; padding-top: 0; padding-bottom: 0; }
  .chapter-nav-link { max-width: none; min-height: 72px; justify-content: center; padding: 12px 0; border-bottom: 1px solid var(--rule); }
  .chapter-nav-link[style] { text-align: left !important; }
}
</style>
