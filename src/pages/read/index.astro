---
import { chapterNum } from '../../lib/chapters';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const chapters = await getCollection('chapters');
const sorted = chapters.sort((a, b) => a.data.n - b.data.n);
const manuscript = await getCollection('manuscript', (e) => e.data.kind === 'full');
const minutes = Object.fromEntries(manuscript.map((e) => [e.data.n, e.data.readMinutes]));
const totalMinutes = manuscript.reduce((sum, e) => sum + e.data.readMinutes, 0);
---
<Base title="Read" description="Nine chapters on coordination intelligence. Read the opening of each free, and unlock more in full by confirming one email.">
  <section class="kw-section">
    <p class="kw-label">Read Free</p>
    <h1 class="kw-h2">Nine chapters.</h1>
    <p class="kw-notice" id="read-notice" role="status" hidden></p>
    <p class="kw-body" style="margin-bottom: 40px">
      Every chapter opens with a scene where coordination intelligence became visible in the world.
      The opening of each is right here. Confirm one email to read them in full, the capstone included, about {Math.round(totalMinutes / 60)} hours of reading.
    </p>

    <div class="read-list">
      {sorted.map((ch) => (
        <a href={`/read/${ch.id}`} class="read-item">
          <span class="read-num mono">{chapterNum(ch.data.n)}</span>
          <div class="read-body">
            <p class="read-opener">{ch.data.opener}</p>
            <p class="read-title">{ch.data.title} · {minutes[ch.data.n]} min</p>
          </div>
          <span class="read-arrow mono">→</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
.read-list { border-top: 1px solid var(--rule); }
.read-item {
  display: flex; gap: 20px; align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid var(--rule);
  transition: background 0.1s;
}
.read-item:hover { background: var(--accent-soft); box-shadow: -24px 0 0 var(--accent-soft), 24px 0 0 var(--accent-soft); }
.kw-notice {
  font-size: 15px; line-height: 1.5; max-width: 60ch;
  background: var(--accent-soft); color: var(--ink);
  padding: 12px 16px; margin: 0 0 24px;
}
.read-num {
  font-size: 11px; color: var(--signal-ink); letter-spacing: .08em; flex-shrink: 0; width: 28px;
}
.read-body { flex: 1; }
.read-opener {
  font: 600 16px/1.3 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -.01em; color: var(--ink); margin: 0 0 4px;
}
.read-title {
  font: 400 11px/1 "JetBrains Mono", ui-monospace, monospace;
  color: var(--sub); margin: 0; letter-spacing: .04em;
}
.read-arrow { color: var(--sub2); font-size: 13px; flex-shrink: 0; }
</style>

<script>
  const NOTICES: Record<string, string> = {
    'link=expired': 'That link was already used or has expired. Open any chapter and enter your email to get a new one.',
    'link=invalid': 'That link is not valid. Open any chapter and enter your email to get a new one.',
    'signed-out=1': 'You are signed out on this device. Enter your email at any chapter to get a new sign-in link.',
  };
  const params = new URLSearchParams(window.location.search);
  const key = Object.keys(NOTICES).find((k) => { const [name, value] = k.split('='); return params.get(name) === value; });
  const notice = document.getElementById('read-notice');
  if (key && notice) {
    notice.textContent = NOTICES[key];
    notice.hidden = false;
  }
</script>
