---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import ListForm from '../components/ListForm.astro';
import { WAITLIST_CONSENT } from '../../lib/site-facts.mjs';
import { PRICE_PREORDER, PRICE_PRINT, PRICE_DIGITAL, CHECKOUT_OPEN, CONTACT_EMAIL } from '../config';

const DESCRIPTION = CHECKOUT_OPEN
  ? `Pre-order Knowware: ${PRICE_PREORDER} before the solstice.`
  : `Pre-orders for Knowware (${PRICE_PREORDER}, print and digital, ships December 21, 2026) are not open yet. Leave an email and we will write to you once, when they open.`;
---
<Base title="Pre-order" description={DESCRIPTION}>
  <section class="kw-section" aria-labelledby="order-h">
    <p class="kw-label">Pre-order</p>
    <h1 class="kw-h2" id="order-h">Pre-orders open soon.</h1>
    <p class="kw-body">
      Knowware ships on the solstice: December 21, 2026. The pre-order is not open yet, so there is nothing to buy today. Leave your email, confirm it, and we will write to you once, the day it opens.
    </p>
  </section>

  <Field height="180px" sigTop="50%" />

  <section class="kw-section wl" id="waitlist">
    <p class="kw-label">The pre-order list</p>
    <ListForm id="wl" endpoint="/api/waitlist" heading="Tell me when it opens." button="Email me a confirmation →" consent={WAITLIST_CONSENT}
      sent="Check your email. Press the button in it to confirm your place. After that you will hear from us once, the day pre-orders open.">
      This is a separate list from chapter news. <a href="/privacy">Privacy</a>. Leave any time: every email has an unsubscribe link, or write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </ListForm>
  </section>

  <section class="kw-section">
    <div class="pricing-grid">
      <div class="pricing-card pricing-card--featured">
        <p class="kw-label">{CHECKOUT_OPEN ? 'Pre-order' : 'Planned pre-order price'}</p>
        <p class="pricing-price">{PRICE_PREORDER}</p>
        <p class="pricing-desc kw-body">{CHECKOUT_OPEN ? 'Print + digital bundle. The launch price.' : 'Print + digital bundle. The planned launch price, confirmed on the day pre-orders open. Join the list above to hear then.'}</p>
      </div>
      <div class="pricing-card">
        <p class="kw-label">{CHECKOUT_OPEN ? 'At Print' : 'Planned price at print'}</p>
        <p class="pricing-price">{PRICE_PRINT}</p>
        <p class="pricing-desc kw-body">{CHECKOUT_OPEN ? 'Full retail price after December 21.' : 'Planned retail price after December 21.'}</p>
      </div>
      <div class="pricing-card">
        <p class="kw-label">{CHECKOUT_OPEN ? 'Digital Only' : 'Planned digital price'}</p>
        <p class="pricing-price">{PRICE_DIGITAL}</p>
        <p class="pricing-desc kw-body">{CHECKOUT_OPEN ? 'PDF + ePub edition, available at launch.' : 'PDF + ePub edition, planned for launch.'}</p>
      </div>
    </div>
  </section>

  <section class="kw-section">
    <p class="kw-label">What you get</p>
    <ul class="what-list kw-body">
      <li>9 chapters on coordination intelligence</li>
      <li>81 structured voices — 27 academics, 27 practitioners, 27 visionaries</li>
      <li>Original three-body diagrams for each chapter</li>
      <li>Named contributor line (if you contribute a voice before the deadline)</li>
    </ul>
  </section>
</Base>

<style>
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 1px; border: 1px solid var(--rule);
}
.pricing-card { padding: 32px 24px; background: var(--paper); }
.pricing-card--featured { background: var(--band-bg); color: var(--band-ink); }
.pricing-card--featured .kw-label { color: var(--band-accent); }
.pricing-card--featured .kw-body { color: var(--band-sub); }
.pricing-price {
  font: 800 clamp(40px,6vw,80px)/1 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -.04em; margin: 16px 0 8px;
}
.what-list { padding-left: 20px; }
.what-list li { margin-bottom: 8px; }
</style>
