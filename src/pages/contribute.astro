---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
---
<Base title="Contribute" description="Claim Line 82. Add a voice to Knowware before the solstice.">
  <section class="kw-section">
    <p class="kw-label">The 82nd Line</p>
    <h1 class="kw-h2">Line 82 is yours.</h1>
    <p class="kw-body">
      The book has 81 voices. The 82nd belongs to the reader who contributes one.
      Nominate a living thinker whose work illuminates coordination intelligence —
      and if the author accepts, your name goes in the book.
    </p>
  </section>

  <!-- The 82nd line field -->
  <Field variant="82" caption="Line 82 is yours." />

  <section class="kw-section">
    <p class="kw-label">How it works</p>
    <ol class="contribute-steps kw-body">
      <li>Submit a name and one paragraph on why this voice belongs.</li>
      <li>The author reviews. Accepted voices are added to the chapter where they fit best.</li>
      <li>Your name appears in the colophon: "Line 82 contributed by [you]."</li>
      <li>Deadline: December 21, 2026 — the solstice.</li>
    </ol>
  </section>

  <!-- Claim form -->
  <section class="kw-section" id="claim" aria-labelledby="claim-h">
    <h2 class="kw-label" id="claim-h">Submit a voice</h2>
    <p class="form-note" id="form-note">Every field is required unless marked optional.</p>
    <form
      id="claim-form"
      action="/api/claim"
      method="POST"
      class="claim-form"
      novalidate
      aria-describedby="form-note"
    >
      <div class="field-group">
        <label for="your-name" class="field-label">Your name</label>
        <p class="field-hint" id="your-name-hint">As it should appear in the colophon.</p>
        <input type="text" id="your-name" name="yourName" required maxlength="120" autocomplete="name" class="field-input" aria-describedby="your-name-hint your-name-err" />
        <p class="field-error" id="your-name-err"></p>
      </div>
      <div class="field-group">
        <label for="your-email" class="field-label">Your email</label>
        <p class="field-hint" id="your-email-hint">For correspondence only. Never published.</p>
        <input type="email" id="your-email" name="email" required maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" class="field-input" aria-describedby="your-email-hint your-email-err" />
        <p class="field-error" id="your-email-err"></p>
      </div>
      <div class="field-group">
        <label for="voice-name" class="field-label">Nominee's name</label>
        <input type="text" id="voice-name" name="voiceName" required maxlength="160" autocomplete="off" class="field-input" aria-describedby="voice-name-err" />
        <p class="field-error" id="voice-name-err"></p>
      </div>
      <div class="field-group">
        <label for="voice-role" class="field-label">Nominee's role or affiliation</label>
        <input type="text" id="voice-role" name="voiceRole" required maxlength="240" autocomplete="off" class="field-input" aria-describedby="voice-role-err" />
        <p class="field-error" id="voice-role-err"></p>
      </div>
      <div class="field-group">
        <label for="why" class="field-label">Why this voice?</label>
        <p class="field-hint" id="why-hint">One paragraph. Be specific about what they have said or written.</p>
        <textarea id="why" name="why" required maxlength="2000" class="field-input field-textarea" rows="5" aria-describedby="why-hint why-err"></textarea>
        <p class="field-error" id="why-err"></p>
      </div>
      <div class="field-group">
        <label for="chapter" class="field-label">Suggested chapter (optional)</label>
        <select id="chapter" name="chapter" class="field-input">
          <option value="">No preference</option>
          <option value="1">01 · The Coordination Intelligence Revolution</option>
          <option value="2">02 · The Dawn of Systems Intelligence</option>
          <option value="3">03 · Architecture of Systems Intelligence</option>
          <option value="4">04 · Systems Intelligence in Action</option>
          <option value="5">05 · Human-Systems Intelligence Interaction</option>
          <option value="6">06 · Consciousness as Pattern Recognition</option>
          <option value="7">07 · Engineering Reality</option>
          <option value="8">08 · Beyond Human Intelligence</option>
          <option value="9">09 · No Way Know-How</option>
        </select>
      </div>
      <div class="field-trap" aria-hidden="true">
        <label for="company">Company</label>
        <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <button type="submit" class="kw-btn kw-btn--filled" style="margin-top:8px">
        Submit nomination →
      </button>
      <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>

<style>
.contribute-steps {
  padding-left: 24px;
  max-width: 560px;
}
.contribute-steps li { margin-bottom: 12px; }

.claim-form { max-width: 520px; display: flex; flex-direction: column; gap: 20px; }
.field-group { display: flex; flex-direction: column; gap: 6px; }
.field-label {
  font: 600 11px/1 "JetBrains Mono", ui-monospace, monospace;
  letter-spacing: .08em; text-transform: uppercase; color: var(--sub);
}
.field-input {
  background: var(--paper); color: var(--ink);
  border: 1px solid var(--rule-strong);
  padding: 10px 14px;
  font: 400 14px/1.4 "JetBrains Mono", ui-monospace, monospace;
  transition: border-color 0.15s;
  width: 100%;
}
.field-input:focus { border-color: var(--signal); }
.field-input[aria-invalid="true"] { border-color: var(--error); border-width: 2px; }
.form-note { font-size: 14px; color: var(--sub); margin: 0 0 20px; }
.field-hint { font-size: 13px; color: var(--sub); margin: 0; line-height: 1.4; }
.field-error {
  font: 500 13px/1.4 "Helvetica Neue", Helvetica, Arial, sans-serif;
  color: var(--error); margin: 0;
}
.field-error:empty { display: none; }
.field-error::before { content: "Error: "; font-weight: 700; }
.field-trap { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
.form-status:empty { display: none; }
.form-status.is-error { color: var(--error); }
.field-textarea { resize: vertical; min-height: 120px; }
.form-status {
  font: 400 13px/1.4 "JetBrains Mono", ui-monospace, monospace;
  color: var(--sub);
  padding: 12px; border: 1px solid var(--rule);
}
</style>

<script>
const form = document.getElementById('claim-form') as HTMLFormElement | null;
const status = document.getElementById('form-status') as HTMLElement | null;

const MESSAGES: Record<string, string> = {
  yourName: 'Enter your name.',
  email: 'Enter a valid email address, like name@example.com.',
  voiceName: 'Enter the nominee\'s name.',
  voiceRole: 'Enter the nominee\'s role or affiliation.',
  why: 'Tell us why this voice belongs in the book.',
};

function fieldFor(name: string) {
  return form?.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null;
}

function setError(name: string, message: string) {
  const el = fieldFor(name);
  if (!el) return;
  const err = document.getElementById(`${el.id}-err`);
  if (message) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
  if (err) err.textContent = message;
}

function validate(): string[] {
  const bad: string[] = [];
  for (const name of Object.keys(MESSAGES)) {
    const el = fieldFor(name);
    if (!el) continue;
    el.value = el.value.trim();
    const ok = el.checkValidity();
    setError(name, ok ? '' : MESSAGES[name]);
    if (!ok) bad.push(name);
  }
  return bad;
}

function setStatus(text: string, isError = false) {
  if (!status) return;
  status.textContent = text;
  status.classList.toggle('is-error', isError);
}

for (const name of Object.keys(MESSAGES)) {
  fieldFor(name)?.addEventListener('blur', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.getAttribute('aria-invalid') === 'true') setError(name, el.checkValidity() ? '' : MESSAGES[name]);
  });
}

form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!form) return;

  const bad = validate();
  if (bad.length) {
    setStatus(`${bad.length === 1 ? 'One field needs' : `${bad.length} fields need`} attention.`, true);
    fieldFor(bad[0])?.focus();
    return;
  }

  const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
  btn.disabled = true;
  btn.textContent = 'Submitting…';
  setStatus('Submitting your nomination…');

  try {
    const res = await fetch('/api/claim', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(Object.fromEntries(new FormData(form))),
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.ok) {
      setStatus('Nomination submitted. The author will be in touch if it is accepted.');
      form.reset();
    } else {
      const fields: string[] = Array.isArray(data.fields) ? data.fields : [];
      fields.forEach((f) => setError(f, MESSAGES[f] ?? 'Check this field.'));
      if (fields[0]) fieldFor(fields[0])?.focus();
      setStatus(data.error ?? 'The nomination was not submitted. Try again in a moment.', true);
    }
  } catch {
    setStatus('The nomination was not submitted because the connection failed. Check your connection and try again.', true);
  } finally {
    btn.disabled = false;
    btn.textContent = 'Submit nomination →';
  }
});
</script>
