---
import Base from '../../layouts/Base.astro';
---
<Base title="Check your email" description="If we hold anything for that address, we sent a link to manage it." noindex>
  <section class="kw-section" aria-labelledby="us-h">
    <p class="kw-label">Unsubscribe</p>
    <h1 class="kw-h2" id="us-h">Check your email.</h1>
    <p class="kw-body">If we hold anything for that address, a link is on its way. It works once and lasts 24 hours. Open it and choose what to remove.</p>
  </section>
</Base>
