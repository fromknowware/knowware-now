---
import Base from '../../layouts/Base.astro';
import { CONTACT_EMAIL } from '../../config';
const link = 'color: var(--signal-ink);border-bottom: 1px solid var(--signal-ink)';
---
<Base title="Unsubscribe" description="Stop Knowware email, leave the pre-order list, or have what we hold about you deleted." noindex>
  <section class="kw-section" aria-labelledby="un-h">
    <p class="kw-label">Unsubscribe</p>
    <h1 class="kw-h2" id="un-h">Leave, or be deleted.</h1>
    <p class="kw-notice" id="un-notice" role="status" hidden></p>
    <p class="kw-body">Enter your email. If we hold anything for it we send one link, and you choose there: stop news emails, leave the pre-order list, or delete everything. Nobody else can do this for you. Prefer a person? Write to <a href={`mailto:${CONTACT_EMAIL}`} style={link}>{CONTACT_EMAIL}</a>.</p>

    <form class="un-form" id="un-form" method="post" action="/api/remove/request" novalidate>
      <div class="un-field">
        <label for="un-email">Email</label>
        <input type="email" id="un-email" name="email" required maxlength="254" autocomplete="email" inputmode="email" spellcheck="false" aria-describedby="un-err" />
        <p class="un-err" id="un-err"></p>
      </div>
      <div class="un-trap" aria-hidden="true">
        <label for="un-company">Company</label>
        <input type="text" id="un-company" name="company" tabindex="-1" autocomplete="off" />
      </div>
      <button type="submit" class="kw-btn kw-btn--filled" id="un-submit">Email me the link →</button>
      <p class="un-live" id="un-live" role="status" aria-live="polite"></p>
    </form>
  </section>
</Base>

<script>
  const notices: Record<string, string> = {
    invalid: 'That link is not valid. Enter your email to get a new one.',
    expired: 'That link was already used or has expired. Enter your email to get a new one.',
  };
  const note = new URLSearchParams(window.location.search).get('link') ?? '';
  const box = document.getElementById('un-notice')!;
  if (notices[note]) { box.textContent = notices[note]; box.hidden = false; }

  const form = document.getElementById('un-form') as HTMLFormElement;
  const email = document.getElementById('un-email') as HTMLInputElement;
  const err = document.getElementById('un-err')!;
  const live = document.getElementById('un-live')!;
  const submit = document.getElementById('un-submit') as HTMLButtonElement;
  const setError = (msg: string) => { err.textContent = msg; if (msg) email.setAttribute('aria-invalid', 'true'); else email.removeAttribute('aria-invalid'); };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    email.value = email.value.trim();
    if (!email.checkValidity()) { setError('Enter a valid email address, like name@example.com.'); live.textContent = ''; email.focus(); return; }
    setError('');
    submit.disabled = true;
    live.textContent = 'Sending…';
    try {
      const res = await fetch('/api/remove/request', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email.value, company: (document.getElementById('un-company') as HTMLInputElement).value }),
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.ok) {
        live.textContent = 'Check your email. If we hold anything for that address, a link is on its way. It works once and lasts 24 hours.';
        live.tabIndex = -1; live.focus();
        return;
      }
      if (Array.isArray(data.fields) && data.fields.includes('email')) { setError(data.error ?? 'Enter a valid email address.'); live.textContent = ''; email.focus(); }
      else live.textContent = data.error ?? 'Something went wrong. Try again in a moment.';
    } catch {
      live.textContent = 'Could not reach the server. Try again in a moment.';
    } finally {
      submit.disabled = false;
    }
  });
</script>

<style is:global>
  .un-form { display: grid; gap: 16px; max-width: 460px; margin-top: 24px; }
  .un-field label { display: block; font: 500 13px/1.3 "JetBrains Mono", ui-monospace, monospace; margin-bottom: 6px; color: var(--ink); }
  .un-field input { width: 100%; box-sizing: border-box; padding: 12px; font: 400 16px/1.3 "JetBrains Mono", ui-monospace, monospace; color: var(--ink); background: transparent; border: 1px solid var(--rule-strong); border-radius: 0; }
  .un-field input:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .un-field input[aria-invalid="true"] { border-width: 2px; border-color: var(--error); }
  .un-err { margin: 6px 0 0; font-size: 13px; color: var(--error); }
  .un-err:empty { display: none; }
  .un-trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .un-live { margin: 0; font-size: 17px; line-height: 1.45; color: var(--ink); min-height: 1.4em; }
  .un-live:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .kw-notice { font-size: 15px; line-height: 1.5; max-width: 60ch; background: var(--accent-soft); color: var(--ink); padding: 12px 16px; margin: 0 0 24px; }
</style>
