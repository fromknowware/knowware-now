---
import Base from '../../layouts/Base.astro';
import StoriesNote from '../../components/StoriesNote.astro';
import StoryBadges from '../../components/StoryBadges.astro';
import { SITE_NAME, SITE_URL } from '../../config';
import { getPublishedStories, LAYER_LABEL, GRADE_LABEL, eventLine, formatDate, FEED_CAP } from '../../lib/stories';

const stories = await getPublishedStories();
const PAGE_URL = `${SITE_URL}/stories`;
const DESCRIPTION =
  'A running, cited log of real stories where systems coordinated or acted at speed and nobody held the knowing: the context, the meaning, the accountability. Newest first, each graded by evidence.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${SITE_NAME} stories`,
  url: PAGE_URL,
  description: DESCRIPTION,
  inLanguage: 'en',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: stories.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}/stories/${s.id}`,
      name: s.data.headline,
    })),
  },
};
---
<Base title="Stories" description={DESCRIPTION} canonical={PAGE_URL}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="kw-section st-head" aria-labelledby="st-h">
    <p class="kw-label">Stories · a running log</p>
    <h1 class="kw-h2 st-title" id="st-h">Coordination without knowing</h1>
    <p class="kw-prose-dek">Real cases where systems coordinated or acted at speed and nobody held the knowing: what the work was for, what the context was, who answered for it. Cited, graded, newest first.</p>
    <p class="st-links">
      <a class="kw-btn kw-btn--filled" href="/feed.xml">Atom feed</a>
      <a class="kw-btn" href="/definition">What is knowware?</a>
    </p>
    <dl class="st-legend">
      <div><dt>Grade A</dt><dd>{GRADE_LABEL.A}</dd></div>
      <div><dt>Grade B</dt><dd>{GRADE_LABEL.B}</dd></div>
      <div><dt>Grade C</dt><dd>{GRADE_LABEL.C}</dd></div>
    </dl>
    <StoriesNote />
  </section>

  <section class="kw-section st-list" aria-labelledby="st-list-h">
    <h2 class="kw-label" id="st-list-h">{stories.length} {stories.length === 1 ? 'story' : 'stories'}{stories.length >= FEED_CAP ? ` · the feed carries the newest ${FEED_CAP}` : ''}</h2>
    <ol class="st-items">
      {stories.map((s) => (
        <li class="st-item">
          <article aria-labelledby={`h-${s.id}`}>
            <p class="st-meta mono">
              <span>Event: {eventLine(s)}</span>
              <span>Added: {formatDate(s.data.added)}</span>
              <StoryBadges grade={s.data.grade} simulation={s.data.simulation} alleged={s.data.alleged} />
            </p>
            <h3 class="kw-h3 st-h" id={`h-${s.id}`}><a href={`/stories/${s.id}`}>{s.data.headline}</a></h3>
            <p class="st-summary">{s.data.summary}</p>
            <p class="st-layer"><span class="st-layer-k mono">Missing layer</span> {LAYER_LABEL[s.data.missingLayer]}</p>
            <p class="st-more"><a href={`/stories/${s.id}`}>Read the cited write-up →</a></p>
          </article>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .st-head { padding-bottom: clamp(28px, 4vw, 48px); }
  .st-title { max-width: 18ch; }
  .st-links { display: flex; gap: 12px; flex-wrap: wrap; margin: 0 0 28px; }
  .st-links .kw-btn--filled { color: #EDEEE4; }
  .st-legend { display: grid; gap: 8px; margin: 0; max-width: 78ch; font-size: 14px; line-height: 1.5; }
  .st-legend div { display: grid; grid-template-columns: 7em 1fr; gap: 12px; }
  .st-legend dt { font: 600 11px/1.6 "JetBrains Mono", ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; color: var(--ink); }
  .st-legend dd { margin: 0; color: var(--sub); }
  .st-list { border-bottom: none; }
  .st-list .kw-label { margin-bottom: 8px; }
  .st-items { list-style: none; margin: 0; padding: 0; }
  .st-item { padding: 28px 0; border-top: 1px solid var(--rule); }
  .st-item:first-child { border-top: 2px solid var(--ink); }
  .st-meta { display: flex; gap: 8px 16px; flex-wrap: wrap; align-items: center; margin: 0 0 12px; font-size: 12px; line-height: 1.4; color: var(--sub); }
  .st-h { max-width: 30ch; margin-bottom: 12px; }
  .st-h a { text-decoration: none; }
  .st-h a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .st-summary { max-width: 68ch; margin: 0 0 14px; font-size: 16px; line-height: 1.6; color: var(--ink); }
  .st-layer { margin: 0 0 12px; font-size: 15px; font-weight: 600; }
  .st-layer-k { display: inline-block; margin-right: 10px; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--sub); }
  .st-more { margin: 0; font: 500 13px/1.4 "JetBrains Mono", ui-monospace, monospace; }
  .st-more a { color: var(--signal-ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 520px) {
    .st-legend div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
