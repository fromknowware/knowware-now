---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import Disclosure from '../components/Disclosure.astro';
import { STRIPE_URL, VOICES_COUNT, CHAPTERS_COUNT, PRICE_PREORDER } from '../config';
import { getCollection } from 'astro:content';

const chapters = await getCollection('chapters');
const voices = await getCollection('voices');

const chaptersSorted = chapters.sort((a, b) => a.data.n - b.data.n);
---
<Base>
  <!-- Cover hero -->
  <div class="kw-hero-cover">
    <Field height="360px" sigTop="41%" />
    <h1 class="kw-hero-word">KNOWWARE</h1>
    <div class="kw-hero-foot">
      <p class="kw-hero-tag">
        Systems of Intelligence<br />
        <span style="color: var(--sub2); font-size: 0.85em">Khayyam Wakil · MMXXVI · Ed. 01</span>
      </p>
      <div class="kw-hero-cta">
        <a href={STRIPE_URL} class="kw-btn kw-btn--filled">Pre-order · {PRICE_PREORDER} →</a>
        <a href="/read" class="kw-btn">Read free →</a>
      </div>
    </div>
  </div>

  <!-- Synthesis disclosure -->
  <Disclosure />

  <!-- Method section -->
  <section class="kw-section" id="method">
    <p class="kw-label">The Third Body</p>
    <h2 class="kw-h2">Not interviews. Synthesis.</h2>
    <p class="kw-body">
      The corpus is not the person. These are not transcripts — they are a form of coordination intelligence in action.
      {VOICES_COUNT} thinkers, dead and living, placed in structured dialogue by the author. The Third Body is what emerges in the space between them.
    </p>
  </section>

  <!-- Nine chapters -->
  <section class="kw-section" id="chapters">
    <p class="kw-label">{CHAPTERS_COUNT} Chapters</p>
    <div class="chapters-grid">
      {chaptersSorted.map((ch) => (
        <a href={`/read/${ch.slug}`} class="chapter-card">
          <span class="chapter-num mono">{String(ch.data.n).padStart(2, '0')}</span>
          <div>
            <p class="chapter-opener">{ch.data.opener}</p>
            <p class="chapter-title">{ch.data.title}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Field divider -->
  <Field variant="divider" />

  <!-- The 81 teaser -->
  <section class="kw-section" id="cast">
    <p class="kw-label">The {VOICES_COUNT}</p>
    <h2 class="kw-h2">Who speaks.</h2>
    <p class="kw-body" style="margin-bottom: 32px">
      Academics, practitioners, and visionaries — nine per chapter.
      Legacy voices, living researchers, and anonymised insiders.
    </p>
    <a href="/the-81" class="kw-btn">View all {VOICES_COUNT} voices →</a>
  </section>
</Base>

<style>
.chapters-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1px;
  border: 1px solid var(--rule);
}
.chapter-card {
  padding: 24px;
  border: none;
  display: flex; gap: 16px; align-items: flex-start;
  background: var(--paper);
  transition: background 0.15s;
}
.chapter-card:hover { background: var(--accent-soft); }
.chapter-num {
  font-size: 11px; color: var(--signal);
  letter-spacing: .08em; flex-shrink: 0; padding-top: 3px;
}
.chapter-opener {
  font: 600 15px/1.3 "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -.01em; color: var(--ink); margin: 0 0 6px;
}
.chapter-title {
  font: 400 11px/1 "JetBrains Mono", ui-monospace, monospace;
  color: var(--sub); margin: 0; letter-spacing: .04em;
}
</style>
